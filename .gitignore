# --- Large data / model checkpoints ---
# CRCNS V1/V2 .mat sessions (≈30 MB each, 5 files ≈ 150 MB)
# Users should download these directly from CRCNS:
# https://crcns.org/data-sets/vc/v1v2-1
Fig2/*.mat
Fig2/**/*.mat

# CRCNS pvc-8 and pvc-11 redistributable datasets — not redistributed here
Fig2/pvc8/
Fig2/pvc11/

# Fig5 simulation checkpoint (122 MB) — regenerated by running the script
Fig5/checkpoint.mat
Fig5/**/*.mat

# Fig7 IMAGES.mat (van Hateren patches) — bundled with original SparseNet code
Fig7/src/model/IMAGES.mat
Fig7/**/*.mat

# Manuscript build artifacts and large media
*.pptx
archive/
*.aux
*.bcf
*.run.xml
*.synctex.gz

# Fig2 v1_decoder generated outputs (regenerated by running the script)
Fig2/v1_decoder_*.pdf
Fig2/v1_decoder_*.png
# Keep the .json and .txt summaries — they're small and useful for inspection

# Training output records (regenerated by re-running training scripts)
Fig7/runs_16_new/
Fig7/runs_cv_16_nl_new/
Fig7/runs_cauchy_16_nl_new/
Fig7/record/
Fig7/p3_matched/results/

# --- Editor / IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- Output figures (manuscript-version PDFs are tracked separately) ---
# Keep small reference PDFs; ignore intermediate previews
*_preview.pdf
*_draft.pdf

# --- iCloud sync detritus ---
.iCloud
*.icloud

# --- Misc ---
*.log
node_modules/
