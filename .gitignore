*.pptx
archive/
dump/
*.aux
*.bcf
*.run.xml
*.synctex.gz

# Fig2 v1_decoder generated outputs (regenerated by running the script)
Fig2/v1_decoder_*.pdf
Fig2/v1_decoder_*.png
