# --- Large data / model checkpoints (paths updated for new folder layout) ---
# CRCNS V1/V2 .mat sessions (≈30 MB each, 5 files ≈ 150 MB) — Fig 2
# Users should download these directly from CRCNS:
# https://crcns.org/data-sets/vc/v1v2-1
Fig2/*.mat
Fig2/**/*.mat

# CRCNS pvc-8 and pvc-11 redistributable datasets — not redistributed here
Fig2/pvc8/
Fig2/pvc11/

# Recurrent-network simulation checkpoints + intermediate state (Fig 4)
# checkpoint.mat ≈ 122 MB — regenerated by running figure4_main.m
Fig4/checkpoint.mat
Fig4/*.mat

# Single-neuron model intermediate results (Fig 3)
Fig3/*.mat

# CV-max engineering large files (Fig 6)
# van Hateren patches — bundled with the original SparseNet code, not redistributed
Fig6/src/model/IMAGES.mat
Fig6/**/*.mat
# Training output records (TensorBoard event files + per-seed mats) — regenerated
Fig6/runs_16_new/
Fig6/runs_cv_16_nl_new/
Fig6/runs_cauchy_16_nl_new/
Fig6/record/
Fig6/p3_matched/results/

